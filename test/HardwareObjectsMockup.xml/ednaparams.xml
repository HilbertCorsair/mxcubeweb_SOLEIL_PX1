<object class="PX1XrayCentring" role="workflow">

  <tangoname>i10-c-cx1/ex/pandacollect</tangoname>
  <sgonaxis>i10-c-cx1/ex/sgonaxis</sgonaxis>
  <bes_host>mxcubeweb</bes_host>
  <bes_port>8100</bes_port>

  <channel type="tango" name="state">State</channel>
  <!-- <object href="/xray_centring" role="xray_centring"/> -->
  <object href="/session" role="session"/>
  <workflow>
    <title>WF Mesh Scan</title>
    <path>MeshScan</path>
    <requires>grid</requires>
  </workflow>
  <workflow>
    <title>X-ray Centring</title>
    <path>XrayCentring</path>
    <requires>grid</requires>
  </workflow>

  <channel type="tango" name="latest_image_num" polling="300">currentImage</channel>
  <channel type="tango" name="latest_trigger_num" polling="300">currentTrigger</channel>

  <user_enable>True</user_enable>

  <testmode>False</testmode>

  <omega_increment>120</omega_increment>

  <processing>dials</processing>

  <mxcube_createdir_server>http://localhost:9023</mxcube_createdir_server>
  <object href="/minidiff" role="diffractometer"/>
  <object href="/omega" role="omega"/>
  <object href="/sampx" role="sampx"/>
  <object href="/sampy" role="sampy"/>
  <object href="/phiy" role="phiy"/>
  <object href="/phiz" role="phiz"/>
  <object href="/kappa" role="kappa"/>
  <object href="/kappa_phi" role="kappa_phi"/>
  <object href="/lightarm" role="lightarm"/>
  <object href="/smargon" role="smargon"/>
  <object href="/px1environment" role="px1environment"/>
  <object href="/beam_info" role="beaminfo"/>
  <object href="/session" role="session"/>
  <object href="/sample_view" role="graphics_manager"/>

</object>
